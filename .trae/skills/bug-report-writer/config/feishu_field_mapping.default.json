{
  "_comment": "bug-report-writer v1.1.1 默认飞书 Base 字段映射配置。覆盖 90% 常见 Base 表结构,作为自动匹配的兜底映射。",
  "version": "1.1.1",
  "schema_version": "1.0",
  "default_mapping": {
    "问题描述": "title",
    "标题": "title",
    "bug标题": "title",
    "缺陷标题": "title",
    "问题标题": "title",
    "title": "title",

    "开发备注": "description",
    "描述": "description",
    "详情": "description",
    "详细描述": "description",
    "问题详情": "description",
    "description": "description",

    "复现步骤": "steps",
    "重现步骤": "steps",
    "操作步骤": "steps",
    "steps": "steps",

    "期望结果": "expected",
    "预期结果": "expected",
    "expected": "expected",

    "实际结果": "actual",
    "actual": "actual",

    "环境": "environment",
    "测试环境": "environment",
    "environment": "environment",

    "类型": "bug_type",
    "缺陷类型": "bug_type",
    "bug类型": "bug_type",
    "bug_type": "bug_type",

    "状态": "status",
    "处理状态": "status",
    "status": "status",

    "优先级": "priority",
    "严重程度": "priority",
    "等级": "priority",
    "priority": "priority",
    "severity": "priority",

    "负责人": "assignee",
    "处理人": "assignee",
    "指派人": "assignee",
    "assignee": "assignee",

    "提出人": "reporter",
    "提单人": "reporter",
    "创建人": "reporter",
    "reporter": "reporter",

    "提单时间": "created_at",
    "创建时间": "created_at",
    "创建日期": "created_at",
    "created_at": "created_at",

    "截图附件": "attachments",
    "附件": "attachments",
    "截图": "attachments",
    "图片": "attachments",
    "attachments": "attachments"
  },
  "match_strategy": "fuzzy",
  "fuzzy_threshold": 0.8,
  "select_options_mapping": {
    "_comment": "标准 bug 状态值 → 飞书 Base 选项名映射,首次使用时会校验目标选项是否存在,缺失则在导入时输出 WARN。",
    "类型": {
      "bug": "bug",
      "功能": "bug",
      "性能": "bug",
      "AI模型": "bug",
      "UI": "bug",
      "兼容": "bug",
      "数据": "bug",
      "安全": "bug",
      "接口": "bug",
      "需求": "需求"
    },
    "状态": {
      "open": "待解决",
      "in_progress": "待解决",
      "reopen": "待解决",
      "fixed": "待验收",
      "resolved": "待验收",
      "verified": "验收通过",
      "closed": "验收通过",
      "rejected": "验证不通过",
      "wontfix": "验证不通过"
    },
    "优先级": {
      "P0": "P0",
      "P1": "P1",
      "P2": "P2",
      "P3": "P3"
    }
  },
  "merge_rules": {
    "_comment": "当目标表字段比标准 bug 字段少时的智能合并策略。",
    "问题描述": {
      "type": "structured",
      "template": "【问题】{title}\n\n【详细描述】\n{description}\n\n【复现步骤】\n{steps}\n\n【期望结果】\n{expected}\n\n【实际结果】\n{actual}\n\n【环境】{environment}",
      "fallback": "{title} | {description}"
    }
  }
}
